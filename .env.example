# ----------------------------------------------------------------------------
# DX Fishing — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
# ----------------------------------------------------------------------------

# Supabase — públicas (expuestas al navegador, prefijo NEXT_PUBLIC_)
#
# LOCAL (supabase start imprime estos valores en consola):
#   URL  -> http://127.0.0.1:54321
#   ANON -> la "anon key" que muestra `supabase status`
#
# CLOUD (Supabase Dashboard > Project Settings > API):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (para callbacks de auth / OAuth).
# Local: http://localhost:3000   |   Producción: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
